# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application ID (Client ID) from Discord Developer Portal
CLIENT_ID=your_client_id_here

# 
SUPABASE_URL=your_Supabase_URL
SUPABASE_SERVICE_ROLE_KEY=your_Service_Role_Key

# Message processing config
MESSAGE_PROCESSING_WORKERS=5

# Map rotation sync schedule (cron syntax, default: daily at midnight UTC)
# Examples: "0 0 * * *" (daily), "0 */6 * * *" (every 6 hours), "0 * * * *" (hourly)
MAP_SYNC_CRON=0 0 * * *

NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1024