{
  "name": "arc-raiders-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for Arc Raiders map rotation tracking",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && npx copyfiles -u 1 \"src/templates/**/*\" \"src/assets/**/*\" \"src/locales/**/*\" dist",
    "start": "node dist/index.js",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "generate-maps": "ts-node src/scripts/generateMaps.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "arc-raiders"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "@types/node-cron": "^3.0.11",
    "discord.js": "^14.14.1",
    "dotenv": "^17.2.3",
    "i18next": "^25.6.3",
    "i18next-fs-backend": "^2.6.1",
    "node-cron": "^4.2.1",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.31.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "copyfiles": "^2.4.1",
    "supabase": "^2.72.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
